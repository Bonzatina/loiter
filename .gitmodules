; Each city wiki stays its own repository; this one records only a pointer to a
; commit in each. The city repos are untouched by being referenced here, and their
; standalone deployments keep working.
;
;   branch  = main    → `git submodule update --remote` follows that branch
;   shallow = true    → `--depth 1`: the working files without ~420 MB of image
;                        history, which is the real weight of these repos
;
; Content is published to the combined site by bumping the pointers:
;   git submodule update --remote && git commit -am "Bump city content"
;
; The URLs are plain https on purpose — they have to resolve on a build host that
; knows nothing about this machine's ~/.ssh/config. Locally they still go over SSH
; as the personal account, because ~/.gitconfig rewrites them:
;
;   git config --global url."git@github-personal:Bonzatina/".insteadOf \
;                          "https://github.com/Bonzatina/"
;
; The repositories are private, so a build host needs a credential of its own —
; see the token handling in render.yaml.

[submodule "wiki_berlin"]
	path = wiki_berlin
	url = https://github.com/Bonzatina/Loiter-berlin.git
	branch = main
	shallow = true
[submodule "wiki_bratislava"]
	path = wiki_bratislava
	url = https://github.com/Bonzatina/Loiter-bratislava.git
	branch = main
	shallow = true
[submodule "wiki_budapest"]
	path = wiki_budapest
	url = https://github.com/Bonzatina/Loiter-budapest.git
	branch = main
	shallow = true
[submodule "wiki_dresden"]
	path = wiki_dresden
	url = https://github.com/Bonzatina/Loiter-dresden.git
	branch = main
	shallow = true
[submodule "wiki_wroclav"]
	path = wiki_wroclav
	url = https://github.com/Bonzatina/Loiter-wroclav.git
	branch = main
	shallow = true
[submodule "wiki_viena"]
	path = wiki_viena
	url = https://github.com/Bonzatina/Loiter-viena.git
	branch = main
	shallow = true
; The rural wiki, unlike the city repos, still lives on `master`.
[submodule "wiki_rural_travel"]
	path = wiki_rural_travel
	url = https://github.com/Bonzatina/rural_travel.git
	branch = master
	shallow = true
