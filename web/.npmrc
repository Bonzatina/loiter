# Pin the public registry for this project.
#
# The machine's global npm registry is an internal corporate proxy
# (npmproxy.devexpress.devx). Installing through it writes that host into every
# `resolved` URL of package-lock.json — 128 of them — and a build host cannot
# resolve it: `npm ci` then dies with npm's opaque "Exit handler never called!".
# That is what broke the first deploys of this app.
#
# Keeping the registry here means the committed lockfile always carries portable
# https://registry.npmjs.org/ URLs, whoever installs and wherever.
registry=https://registry.npmjs.org/

engine-strict=false
